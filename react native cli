## 5. Backend Implementation (Node.js/Express)

### Step 5.1 — Initialize Firebase Admin

Create `utils/firebaseAdmin.js`:

```javascript
const admin = require('firebase-admin');
// The JSON file you downloaded from Firebase Console Service Accounts
const serviceAccount = require('../config/firebase-service-account.json');

admin.initializeApp({
  credential: admin.credential.cert(serviceAccount),
});

module.exports = admin;
```

### Step 5.2 — Create Push Notification Service

Create `utils/pushNotifications.js`:

```javascript
const admin = require('./firebaseAdmin');

/**
 * Send a native push notification via FCM
 * @param {string} fcmToken - Native device token
 * @param {string} title - Notification title
 * @param {string} body - Notification body text
 * @param {object} data - Payload for deep linking
 */
exports.sendPushNotification = async (fcmToken, title, body, data = {}) => {
  if (!fcmToken) return;

  const message = {
    token: fcmToken,
    notification: {
      title,
      body,
    },
    data: {
      ...data,
      click_action: 'FLUTTER_NOTIFICATION_CLICK', // Legacy requirement for some OS routing
    },
    android: {
      priority: 'high',
      notification: { channelId: 'default' }
    },
    apns: {
      payload: {
        aps: { sound: 'default' }
      }
    }
  };

  try {
    const response = await admin.messaging().send(message);
    console.log('[PushService] Successfully sent:', response);
    return response;
  } catch (error) {
    console.error('[PushService] FCM Error:', error);
  }
};
```

### Step 5.3 — Trigger on Events (e.g., Appointments)

```javascript
// controllers/appointments.js
const { sendPushNotification } = require('../utils/pushNotifications');

exports.updateAppointment = async (req, res, next) => {
  try {
    let appointment = await Appointment.findById(req.params.id);
    const oldStatus = appointment.status;

    appointment = await Appointment.findByIdAndUpdate(
      req.params.id, req.body,
      { returnDocument: 'after', runValidators: true }
    ).populate('doctor', 'name');

    // Send notification when status changes to "confirmed"
    if (req.body.status === 'confirmed' && oldStatus !== 'confirmed') {
      const patient = await User.findById(appointment.patient);
      if (patient?.pushToken) {
        await sendPushNotification(
          patient.pushToken,
          'Appointment Confirmed 🗓️',
          `Your appointment with Dr. ${appointment.doctor?.name} has been confirmed.`,
          { screen: 'Appointments' } // Payload stringified naturally by FCM
        );
      }
    }

    res.status(200).json({ success: true, data: appointment });
  } catch (err) {
    next(err);
  }
};
